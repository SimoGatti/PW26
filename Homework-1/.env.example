# =========================================================================
# TEMPLATE CONFIGURAZIONE DATABASE (ESEMPIO)
# =========================================================================
# Copia questo file in un nuovo file chiamato `.env` nella stessa directory
# e modifica i valori con le tue credenziali locali o di AlterVista.

# Impostare a true per connettersi ad AlterVista, false per il DB locale
USE_ALTERVISTA_DB=false

# --- CONFIGURAZIONE DATABASE LOCALE ---
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_NAME=quiz_db
DB_LOCAL_USER=root
DB_LOCAL_PASS=
DB_LOCAL_CHARSET=utf8mb4

# --- CONFIGURAZIONE DATABASE ALTERVISTA ---
DB_ALTERVISTA_HOST=localhost
DB_ALTERVISTA_PORT=3306
DB_ALTERVISTA_NAME=my_username
DB_ALTERVISTA_USER=username
DB_ALTERVISTA_PASS=your_altervista_db_password
DB_ALTERVISTA_CHARSET=utf8mb4
